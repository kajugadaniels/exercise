# Local application origin. Do not include a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:4000

# Clerk development instance. Replace locally; never commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_WEBHOOK_SIGNING_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# Neon development database. Use Neon's default database, owner, and credentials.
# DATABASE_URL is the pooled application connection; DIRECT_URL is the direct
# connection used only by Prisma CLI commands.
DATABASE_URL=postgresql://NEON_DEFAULT_OWNER:REPLACE_ME@ep-development-pooler.REGION.aws.neon.tech/NEON_DEFAULT_DATABASE?sslmode=require
DIRECT_URL=postgresql://NEON_DEFAULT_OWNER:REPLACE_ME@ep-development.REGION.aws.neon.tech/NEON_DEFAULT_DATABASE?sslmode=require

# Public, version-pinned exercise metadata source.
# Exercise GIF usage remains blocked until media rights are approved.
EXERCISE_PROVIDER_BASE_URL=https://cdn.jsdelivr.net/gh/JahelCuadrado/ExerciseGymGifsDB@v1.1.0
EXERCISE_PROVIDER_VERSION=v1.1.0
