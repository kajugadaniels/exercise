generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  FEMALE
  MALE
}

model User {
  id               String            @id @default(cuid())
  clerkUserId      String            @unique @db.VarChar(64)
  profile          UserProfile?
  trainingSessions TrainingSession[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  gender            Gender
  heightCentimeters Int
  weightGrams       Int
  country           String   @db.VarChar(80)
  completedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model TrainingSession {
  id            String                    @id @default(cuid())
  userId        String
  scheduledDate DateTime                  @db.Date
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises     TrainingSessionExercise[]

  @@unique([userId, scheduledDate])
  @@index([userId, scheduledDate])
}

model TrainingSessionExercise {
  id                     String          @id @default(cuid())
  trainingSessionId      String
  exerciseProvider       String          @db.VarChar(50)
  exerciseSourceId       String          @db.VarChar(200)
  exerciseSourceVersion  String          @db.VarChar(50)
  exerciseAttributionUrl String          @db.VarChar(500)
  exerciseName           String          @db.VarChar(180)
  createdAt              DateTime        @default(now())
  trainingSession        TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)

  @@unique([trainingSessionId, exerciseProvider, exerciseSourceId])
  @@index([trainingSessionId, createdAt])
}
