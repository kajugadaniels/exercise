# Canonical production origin. Replace with the approved HTTPS domain.
NEXT_PUBLIC_APP_URL=https://fitness.example.com

# Clerk production instance. Configure real values in the hosting provider,
# never in this committed example file.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_live_REPLACE_ME
CLERK_WEBHOOK_SIGNING_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# Neon production database. Keep these values server-only in the hosting
# provider. Use Neon's default database, owner, and credentials.
DATABASE_URL=postgresql://NEON_DEFAULT_OWNER:REPLACE_ME@ep-production-pooler.REGION.aws.neon.tech/NEON_DEFAULT_DATABASE?sslmode=require
DIRECT_URL=postgresql://NEON_DEFAULT_OWNER:REPLACE_ME@ep-production.REGION.aws.neon.tech/NEON_DEFAULT_DATABASE?sslmode=require

# Public, version-pinned exercise metadata source.
# Do not enable or redistribute GIF media until rights are approved.
EXERCISE_PROVIDER_BASE_URL=https://cdn.jsdelivr.net/gh/JahelCuadrado/ExerciseGymGifsDB@v1.1.0
EXERCISE_PROVIDER_VERSION=v1.1.0
